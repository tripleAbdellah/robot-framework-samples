# Copy to .env and fill in real values. .env is git-ignored — never commit real
# credentials.

# Which transport to use by default. true = auth_mode=service_principal (API-only,
# no browser/MFA); false or unset = auth_mode=browser. A command-line
# -v AUTH_MODE:... still overrides this when you need a one-off different choice.
DATAVERSE_USE_API=false

# auth_mode=browser (Login Als Behandelaar)
DATAVERSE_USERNAME=
DATAVERSE_PASSWORD=

# auth_mode=service_principal (Azure AD app registration)
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
DATAVERSE_TENANT_ID=
